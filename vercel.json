{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noai, noimageai" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/whitepaper", "destination": "/whitepaper/index.html" },
    { "source": "/whitepaper/", "destination": "/whitepaper/index.html" }
  ]
}
